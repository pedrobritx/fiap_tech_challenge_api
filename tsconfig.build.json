{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "**/*.spec.ts"]
}
